# 用户内容 — 一概不进仓库
material/
_tmp_ocr/
notes/
kb/*
!kb/README.md

# 个人数据（请复制 .example 文件后填写）
profile.md
进程树.md
.tmp-nav-read.txt

# 原始 PDF 与 OCR 临时产物（体积大、非派生品，不入库）

# Obsidian 瞬时工作区状态（打开文件记录，频繁变动）
.obsidian/workspace.json

# kimi-code 工作目录（会话/记忆状态，非项目内容）
.workbuddy/

# 备份文件（git 已提供版本回滚，.bak 冗余且不入库）
*.bak
*.bak/
**/.bak-*/

# 密钥与凭据（若将来出现，一律不入库）
.env
.env.*
*.pem
*.key

# 系统/编辑器
.DS_Store
Thumbs.db

# Python 字节码缓存
__pycache__/
*.pyc
